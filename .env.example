# Copy to .env and fill in. .env is gitignored — real credentials never get committed.
#
# ---------------------------------------------------------------------------
# Temporal Cloud bootstrap credential
# ---------------------------------------------------------------------------
# The API key Vault uses to mint everything else. Two requirements, both
# enforced by plugin 0.3.1 at config time rather than at first use:
#
#   - It must be owned by a service account, not a user. Temporal Cloud's
#     CreateApiKey accepts only service-account owners, so a user-owned key
#     could never be rotated.
#   - That service account must hold the Global Admin account role — the
#     least-privileged predefined role that can manage account-level service
#     accounts and their keys. Account Owner is accepted with a warning, since
#     it also grants billing and account governance the engine never uses.
#
# Find it in the Temporal Cloud UI (Settings > Service accounts > API keys), or
# with tcld:
#   tcld --api-key "$TEMPORAL_CLOUD_API_KEY" apikey list
TEMPORAL_CLOUD_API_KEY=

# No admin service account ID here, and no API key ID either. Both are read
# out of the key itself: the ID from the JWT it is, and the owning service
# account from the key's Cloud Ops record. Supplying either is at best a
# cross-check the plugin has to reconcile, and at worst a typo that points
# rotate-root at somebody else's key. `vault read temporalcloud/config` shows
# both values Vault derived.

# A namespace that already exists, used to demo namespace-scoped least
# privilege. Full form, including the account suffix. For example:
# my-namespace.a1b2c
TEMPORAL_NAMESPACE=

# ---------------------------------------------------------------------------
# Local Vault (dev mode, in Docker)
# ---------------------------------------------------------------------------
# Change VAULT_PORT if 8200 is already taken — `make check-ports` will tell you.
VAULT_PORT=8200
VAULT_TOKEN=root
VAULT_IMAGE=hashicorp/vault:1.20

# ---------------------------------------------------------------------------
# Demo knobs
# ---------------------------------------------------------------------------
# Which release of ausmartway/vault-plugin-secrets-temporalcloud to download.
# Required, and the only place the version is pinned: the scripts carry no
# fallback, so changing it here is the whole upgrade.
PLUGIN_VERSION=0.3.1
# Where the secrets engine gets mounted in Vault.
MOUNT=temporalcloud
