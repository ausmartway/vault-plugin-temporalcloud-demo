# Copy to .env and fill in. .env is gitignored — real credentials never get committed.
#
# ---------------------------------------------------------------------------
# Temporal Cloud setup credential
# ---------------------------------------------------------------------------
# Personal API key owned by a Temporal Cloud user with permission to manage
# service accounts and their API keys. The demo uses this stable setup identity
# to create and clean up resources, but never hands it to Vault. Instead, it
# creates a separate service account and disposable bootstrap key for the
# actual Vault demonstration; rotate-root deletes that temporary key.
#
# Create the personal key in the Temporal Cloud UI under Profile > API keys.
# The owning user must be an Account Owner or Global Admin, or otherwise have
# permission to create service accounts and manage their API keys.
TEMPORAL_CLOUD_API_KEY=

# No API key or owner ID is configured separately; the setup script discovers
# the resources it creates through the Temporal Cloud API.

# A namespace that already exists, used to demo namespace-scoped least
# privilege. Full form, including the account suffix. For example:
# my-namespace.a1b2c
TEMPORAL_NAMESPACE=

# ---------------------------------------------------------------------------
# Local Vault (dev mode, in Docker)
# ---------------------------------------------------------------------------
# Change VAULT_PORT if 8200 is already taken — `make check-ports` will tell you.
VAULT_PORT=8200
VAULT_TOKEN=root
VAULT_IMAGE=hashicorp/vault:1.20

# ---------------------------------------------------------------------------
# Demo knobs
# ---------------------------------------------------------------------------
# Which release of ausmartway/vault-plugin-secrets-temporalcloud to download.
# Required, and the only place the version is pinned: the scripts carry no
# fallback, so changing it here is the whole upgrade.
PLUGIN_VERSION=0.3.3
# Where the secrets engine gets mounted in Vault.
MOUNT=temporalcloud
