# Copy to .env and fill in. .env is gitignored — real credentials never get committed.
#
# ---------------------------------------------------------------------------
# Temporal Cloud bootstrap credential
# ---------------------------------------------------------------------------
# The API key Vault uses to mint everything else. It MUST be owned by a
# service account, not by a user: Temporal Cloud's CreateApiKey only accepts a
# service-account owner, so a user-owned key configures fine and then fails on
# the first `vault read creds/...`.
#
# Find these in the Temporal Cloud UI (Settings -> Service Accounts / API Keys),
# or with tcld:
#   tcld --api-key "$TEMPORAL_API_KEY" apikey list
# The key's `owner.ownerId` is TEMPORAL_ADMIN_SA_ID.
TEMPORAL_API_KEY=

# The service account that owns the key above. Required by the plugin: a token
# does not say who owns it, and the Cloud Ops API cannot look it up.
TEMPORAL_ADMIN_SA_ID=

# No TEMPORAL_API_KEY_ID here on purpose. Plugin 0.1.0 made api_key_id
# read-only: a Temporal Cloud API key is a JWT that names its own ID, so Vault
# reads it out of the key itself and rejects any value you try to supply.

# A namespace that already exists, used to demo namespace-scoped least
# privilege. Full form, including the account suffix: e.g. vault-test.rgumq
TEMPORAL_NAMESPACE=

# ---------------------------------------------------------------------------
# Local Vault (dev mode, in Docker)
# ---------------------------------------------------------------------------
# Change VAULT_PORT if 8200 is already taken — `make check-ports` will tell you.
VAULT_PORT=8200
VAULT_TOKEN=root
VAULT_IMAGE=hashicorp/vault:1.20

# ---------------------------------------------------------------------------
# Demo knobs
# ---------------------------------------------------------------------------
# Which release of ausmartway/vault-plugin-secrets-temporalcloud to download.
PLUGIN_VERSION=0.1.0
# Where the secrets engine gets mounted in Vault.
MOUNT=temporalcloud
